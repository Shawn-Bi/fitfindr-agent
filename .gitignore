# Secrets — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Model response cache and local quota counter (runtime state, not source)
backend/.cache/
backend/.quota.json

# Personal closet photos — local upload tests only
backend/tests/closet_photos/

# Node / Next.js
node_modules/
.next/
out/
.vercel/

# OS / editor noise
.DS_Store
Thumbs.db

# Private local notes — never commit
KICKOFF_PROMPT.md
~$*
# Office / notes files of any name
*.doc
*.docx
*.rtf
*.pages
*.xls
*.xlsx
*.numbers
# Anything named like "...API..." / "...key..." / "...secret..." that is a note,
# not code. (A bare *API* would also hide backend/api/ — Windows git ignores case.)
*API*.txt
*API*.pdf
*API*.csv
*API*.json
*API*.md
*[Kk]ey*.txt
*[Ss]ecret*.txt
*[Cc]redential*
