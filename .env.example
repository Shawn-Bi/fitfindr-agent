# FitFindr environment variables. Copy to .env and fill in values there.
# Never commit .env. Never paste a key into chat, code, logs or screenshots.

# Gemini (used by backend/generate.py)
GEMINI_API_KEY=

# RapidAPI: one key, three hosts
# RESALE_API_HOST covers Depop, Poshmark, Mercari and eBay.
RAPIDAPI_KEY=
RESALE_API_HOST=
ETSY_API_HOST=
FB_MARKETPLACE_HOST=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# live     = real store data, cached 24 h in Supabase (local dev and production)
# fixtures = recorded real responses from backend/tests/fixtures (unit tests only)
FITFINDR_DATA_MODE=live

# Optional tuning (defaults shown). Extra live store searches one user search
# may make when it has fewer than 4 results; image model for "AI preview"
# outfit pictures (empty = off); hosts allowed to make live calls (empty = all).
FITFINDR_BROADEN_LIVE_FETCHES=2
FITFINDR_IMAGE_MODEL=gemini-2.5-flash-image
FITFINDR_LIVE_SOURCES=

# development | production  (production refuses to start in fixtures mode)
APP_ENV=development
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
FRONTEND_ORIGINS=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=